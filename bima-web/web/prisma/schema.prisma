datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  name                String
  passwordHash        String
  role                String              @default("surveyor") // "surveyor" | "supervisor" | "admin"
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  surveySessions      SurveySession[]
  reviewedSubmissions SubmissionVersion[]
  auditLogs           AuditLog[]
  corrections         OfficerCorrection[]
}

model ClassDefinition {
  id                    String                   @id @default(uuid())
  name                  String                   @unique
  displayName           String
  visualDescription     String
  conditionCriteria     String
  feasibilityCriteria   String
  isActive              Boolean                  @default(true)
  mutuallyExclusiveWith String                   @default("[]") // JSON Array of class IDs
  conflictIouThreshold  Float                    @default(0.5)
  samPrompt             String? // Short English noun phrase used by the local SAM3 provider (text prompt)
  samColor              String? // Overlay color for SAM3 results, "#RRGGBB"
  // --- Penilaian risiko (RQ4) ---
  modelClass            String?                  @unique // Nama kelas keluaran model YOLO, mis. "pavedroad_pothole"
  category              String? // Kategori manusiawi: Jalan | Vegetasi | Rambu | Spanduk/Banner | Notis jual/sewa
  categoryGroup         String? // "keselamatan_infrastruktur" | "monitoring_kepatuhan" (null = belum dikelompokkan)
  defaultSeverity       Int? // 1-3; null untuk monitoring_kepatuhan (tidak dapat skor risiko)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  versions              ClassDefinitionVersion[]
  detections            Detection[]
}

model ClassDefinitionVersion {
  id              String          @id @default(uuid())
  classId         String
  versionNumber   Int
  snapshotData    String // JSON snapshot of class fields
  createdAt       DateTime        @default(now())
  classDefinition ClassDefinition @relation(fields: [classId], references: [id], onDelete: Cascade)
  detections      Detection[]
}

model ModelConfig {
  id              String      @id @default(uuid())
  name            String
  provider        String      @default("OpenRouter") // "OpenRouter" | "onpremise"
  modelName       String      @default("qwen/qwen3-vl-8b-instruct")
  endpointUrl     String?
  encryptedApiKey String?
  samMode         String? // SAM3 video algorithm: "optimized" (default) | "fast"
  isDefault       Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  detections      Detection[]
}

model SurveySession {
  id              String              @id @default(uuid())
  name            String
  locationType    String              @default("point") // "point" | "polygon"
  locationGeojson String              @default("{}") // GeoJSON String
  locationAddress String?
  surveyDate      DateTime            @default(now())
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  status          String              @default("berlangsung") // "berlangsung" | "selesai_menunggu_submit" | "menunggu_review" | "disetujui" | "ditolak" | "perlu_perbaikan"
  surveyorId      String
  zoneId          String? // Zona kawasan -> Tingkat Paparan (Exposure)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  surveyor        User                @relation(fields: [surveyorId], references: [id])
  zone            Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  mediaAssets     MediaAsset[]
  submissions     SubmissionVersion[]
  detections      Detection[]
  missedFindings  OfficerCorrection[]
}

model MediaAsset {
  id              String              @id @default(uuid())
  sessionId       String
  fileName        String
  fileType        String // "image" | "video"
  fileUrl         String
  storagePath     String
  durationSeconds Float?
  status          String              @default("queued") // "queued" | "uploading" | "uploaded" | "processing" | "completed" | "failed" | "deleted"
  errorMessage    String?
  idempotencyKey  String?             @unique
  evaluatedClipId String? // Terisi bila nama berkas cocok dengan salah satu dari 35 klip RQ3
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  session         SurveySession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluatedClip   EvaluatedClip?      @relation(fields: [evaluatedClipId], references: [id], onDelete: SetNull)
  segments        MediaSegment[]
  detections      Detection[]
  corrections     OfficerCorrection[]
}

model MediaSegment {
  id                 String      @id @default(uuid())
  mediaAssetId       String
  segmentIndex       Int
  startTime          Float
  endTime            Float
  mediaUrl           String?
  status             String      @default("pending") // "pending" | "processing" | "completed" | "failed"
  extractionMetadata String?     @default("{}") // JSON string
  createdAt          DateTime    @default(now())
  mediaAsset         MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  detections         Detection[]
}

model Detection {
  id               String                  @id @default(uuid())
  sessionId        String
  mediaAssetId     String
  mediaSegmentId   String?
  classId          String
  classVersionId   String?
  className        String
  bbox             String // JSON String: {x: number, y: number, width: number, height: number} normalized 0-1
  condition        String
  feasibility      String // "layak" | "cukup_layak" | "tidak_layak"
  timestampSeconds Float?
  frameIndex       Int?
  locationGeojson  String? // Fallback to session location if empty
  modelConfigId    String?
  modelName        String?
  promptVersion    String?
  confidence       Float?
  // --- Penilaian risiko (RQ4); semua null untuk kelompok monitoring_kepatuhan ---
  severity         Int? // 1-3
  severitySource   String                  @default("bawaan") // "bawaan" (dari kelas) | "petugas" (dikoreksi)
  exposure         Int? // 1-3, disalin dari zona sesi saat temuan dibuat
  riskScore        Int? // severity x exposure: 1,2,3,4,6,9
  priorityBand     String? // "rendah" | "sedang" | "tinggi" | "kritikal"
  reviewStatus     String                  @default("belum_ditinjau") // "belum_ditinjau" | "dikonfirmasi" | "dikoreksi" | "keliru"
  hasConflict      Boolean                 @default(false)
  conflictResolved Boolean                 @default(false)
  conflictDetails  String?                 @default("{}") // JSON string describing conflicting detection IDs & classes
  isDeleted        Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  session          SurveySession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset              @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaSegment     MediaSegment?           @relation(fields: [mediaSegmentId], references: [id], onDelete: SetNull)
  classDefinition  ClassDefinition         @relation(fields: [classId], references: [id])
  classVersion     ClassDefinitionVersion? @relation(fields: [classVersionId], references: [id], onDelete: SetNull)
  modelConfig      ModelConfig?            @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)
  corrections      OfficerCorrection[]
}

model SubmissionVersion {
  id            String        @id @default(uuid())
  sessionId     String
  versionNumber Int
  status        String        @default("menunggu_review") // "menunggu_review" | "disetujui" | "ditolak"
  snapshotData  String // JSON string: full immutable snapshot of survey session, detections, and media assets
  reviewNotes   String?
  rejectReason  String?
  reviewerId    String?
  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  session       SurveySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation(fields: [reviewerId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  changes    String // JSON string describing previous and new values
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
}

// Zona kawasan. Untuk purwarupa, nilai Exposure adalah DATA CONTOH (isSimulated = true), bukan data riil.
model Zone {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  zoneType    String // "jalan_utama" | "hunian" | "area_minim_aktivitas"
  exposure    Int // 1-3 (Rendah | Sedang | Tinggi)
  description String?
  isSimulated Boolean         @default(true)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessions    SurveySession[]
}

// 35 klip uji RQ3 (data riil dari Tracker Evaluasi). Dicocokkan lewat nama berkas.
model EvaluatedClip {
  id                     String       @id @default(uuid())
  clipId                 String       @unique
  fileName               String       @unique
  categories             String       @default("[]") // JSON array kategori ground truth
  hasFinding             Boolean
  durationSeconds        Float
  referenceCaption       String
  validationStatus       String?
  modelCaption           String // teks naratif hasil Qwen2.5-VL-7B-Instruct (zero-shot)
  bleu                   Float?
  llmOverall             Float? // skor keseluruhan LLM-based (0-100)
  completeness           Float? // kelengkapan deteksi (0-1)
  locationAccuracy       Float? // 1-5
  severityAccuracy       Float? // 1-5
  categoriesDetected     String       @default("[]")
  categoriesMissed       String       @default("[]")
  categoriesHallucinated String       @default("[]")
  judgeReason            String?
  generatorModel         String?
  generatorFrames        Int?
  createdAt              DateTime     @default(now())
  mediaAssets            MediaAsset[]
}

// Koreksi petugas (supervisor/admin): menandai temuan keliru, terlewat, atau mengubah kelas/severity.
// Satu baris = satu aksi; riwayat tidak ditimpa. `kind = "terlewat"` tidak punya detectionId.
model OfficerCorrection {
  id               String        @id @default(uuid())
  kind             String // "dikonfirmasi" | "keliru" | "kelas_diubah" | "severity_diubah" | "terlewat"
  detectionId      String?
  sessionId        String
  mediaAssetId     String?
  classId          String? // kelas yang benar (untuk kelas_diubah / terlewat)
  severity         Int? // severity yang benar (untuk severity_diubah)
  bbox             String? // JSON bbox ternormalisasi, untuk "terlewat"
  timestampSeconds Float?
  reason           String?
  actorId          String
  createdAt        DateTime      @default(now())
  detection        Detection?    @relation(fields: [detectionId], references: [id], onDelete: SetNull)
  session          SurveySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  actor            User          @relation(fields: [actorId], references: [id])

  @@index([sessionId])
  @@index([detectionId])
}
