NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX_XXXXXXXXXXX
# Server-only: used to upload compressed media to the img / vids buckets
SUPABASE_SERVICE_ROLE_KEY=
# Optional: ffmpeg binary used for compression (default /usr/bin/ffmpeg, must have libx264 + libwebp)
FFMPEG_PATH=/usr/bin/ffmpeg

# NOTE: Must match the INTERNAL_API_SECRET set in ai-service/.env
INTERNAL_API_SECRET=

FASTAPI_SERVICE_URL=http://127.0.0.1:8000

JWT_SECRET=jwt-super-secret-key-32-chars-min-key!

ENCRYPTION_SECRET_KEY=aes-encryption-key-32bytes!

NEXT_PUBLIC_API_URL=http://localhost:3000

# For AI Inference
OPEN_ROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Connect to Postgres via the shared session-mode pooler with connection pool tuning
DATABASE_URL="postgresql://postgres.XXXXXXXXXXXXXX:XXXXXXXXXXXXXXXXXXX@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?connection_limit=15&pool_timeout=30&connect_timeout=15"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.XXXXXXXXXXXXXXXXXXXXXXXXX:XXXXXXXXXXXXXXXXXXX@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"cd
