NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX_XXXXXXXXXXX
# Optional server-to-server URL. For native local development, point this at the host-mapped API;
# Docker Compose overrides it to http://supabase-api:8000 on the private network.
SUPABASE_INTERNAL_URL=
# Server-only: used to upload compressed media to the img / vids buckets
SUPABASE_SERVICE_ROLE_KEY=
# Optional: ffmpeg binary used for compression (default /usr/bin/ffmpeg, must have libx264 + libwebp)
# Linux/macOS: /usr/bin/ffmpeg. Windows: C:/ffmpeg/bin/ffmpeg.exe (pakai garis miring biasa). Cukup "ffmpeg" bila sudah ada di PATH.
FFMPEG_PATH=/usr/bin/ffmpeg

# NOTE: Must match the INTERNAL_API_SECRET set in ai-service/.env
INTERNAL_API_SECRET=

FASTAPI_SERVICE_URL=http://127.0.0.1:8000

JWT_SECRET=

ENCRYPTION_SECRET_KEY=

NEXT_PUBLIC_API_URL=http://localhost:3000

# For AI Inference
OPEN_ROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Connect to Postgres via the shared session-mode pooler with connection pool tuning
DATABASE_URL="postgresql://postgres.XXXXXXXXXXXXXX:XXXXXXXXXXXXXXXXXXX@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?connection_limit=15&pool_timeout=30&connect_timeout=15"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.XXXXXXXXXXXXXXXXXXXXXXXXX:XXXXXXXXXXXXXXXXXXX@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"cd

# Login session lifetime in seconds (JWT expiry + cookie) and how long the API caches a user's isActive check, in ms
SESSION_MAX_AGE_SECONDS=604800
USER_CACHE_TTL_MS=60000

# Media processing (ffmpeg/ffprobe binaries need libx264 + libwebp; timeouts in ms)
FFPROBE_PATH=/usr/bin/ffprobe
FFPROBE_TIMEOUT_MS=30000
FFMPEG_IMAGE_TIMEOUT_MS=60000
FFMPEG_VIDEO_TIMEOUT_MS=900000
MEDIA_IMAGE_MAX_SIDE=1280
MEDIA_IMAGE_QUALITY=65
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_VIDEO_CRF=30

# Video limit is stored in MediaSettings: default and maximum 120 seconds (2 minutes).

# AI service polling (SAM3 jobs) and default class-conflict IoU threshold
SAM3_POLL_INTERVAL_MS=3000
SAM3_MAX_WAIT_MS=3600000
DEFAULT_CONFLICT_IOU_THRESHOLD=0.5

# Hosts/IPs allowed to open the dev server (comma-separated). Only used by `next dev`; leave empty for none
ALLOWED_DEV_ORIGINS=

# Map and geocoding endpoints (baked in at build time)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
NEXT_PUBLIC_MARKER_ICON_URL=https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png
NEXT_PUBLIC_MARKER_ICON_RETINA_URL=https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png
NEXT_PUBLIC_MARKER_ICON_RED_URL=https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png
NEXT_PUBLIC_MARKER_SHADOW_URL=https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png

# Model form defaults in the admin UI (baked in at build time)
NEXT_PUBLIC_OPENROUTER_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
NEXT_PUBLIC_ONPREMISE_ENDPOINT_URL=
NEXT_PUBLIC_DEFAULT_MODEL_NAME=qwen/qwen3-vl-8b-instruct
NEXT_PUBLIC_DEFAULT_SAM3_MODEL_NAME=sam3_1

# Only for `npm run seed` / `npm run seed:sam3` and the prisma/test_*.ts scripts. Choose your own credentials; nothing is built in
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SURVEYOR_EMAIL=
SEED_SURVEYOR_PASSWORD=
SEED_SUPERVISOR_EMAIL=
SEED_SUPERVISOR_PASSWORD=
SEED_ONPREMISE_MODEL_NAME=

# Penyimpanan media: kosong/"supabase" (bawaan) atau "local" (folder lokal, dilayani lewat /api/files/..., untuk purwarupa tanpa Supabase)
STORAGE_BACKEND=
LOCAL_STORAGE_DIR=

# Frame sampel video (Opsi A: ~0,5 fps maks 24 frame, diekstrak dari berkas ASLI saat unggah)
FRAME_MAX_WIDTH=1280
FRAME_JPEG_QUALITY=3
FRAME_EXTRACT_CONCURRENCY=4

# Batas waktu satu permintaan deteksi YOLO ke ai-service (ms)
YOLO_REQUEST_TIMEOUT_MS=300000

# Kotak halus pada pemutar video (deteksi rapat pada video 720p, terpisah dari temuan resmi)
# Laju deteksi (frame/detik); dibatasi PLAYBACK_MAX_FRAMES per video (video lebih panjang memakai laju lebih rendah)
PLAYBACK_FPS=5
PLAYBACK_MAX_FRAMES=600
# Bila laju yang tersisa di bawah nilai ini, video dilewati (terlalu panjang)
PLAYBACK_MIN_FPS=2
# Ambang IoU pencocokan kotak antar-frame untuk membentuk lintasan, dan jumlah frame berturut-turut tanpa pasangan sebelum lintasan ditutup
PLAYBACK_IOU_MIN=0.3
PLAYBACK_MAX_MISSED=1
# Penautan lintasan ke temuan resmi: IoU minimum pada waktu frame sampel dan toleransi waktu (detik)
PLAYBACK_LINK_IOU_MIN=0.4
PLAYBACK_LINK_TIME_TOLERANCE=0.1
# Deteksi rapat berjalan sebagai job di ai-service: selang pemantauan dan batas total menunggu (ms)
PLAYBACK_POLL_INTERVAL_MS=3000
PLAYBACK_MAX_WAIT_MS=1800000

# Tombol "Akses Cepat (Demo Akun)" di halaman login memakai nilai SEED_* di atas. HANYA untuk demo lokal:
# kata sandi akan terbaca tanpa login. Aktif bila bernilai "true" dan bukan mode production; kosongkan di server nyata
DEMO_LOGIN_ENABLED=
