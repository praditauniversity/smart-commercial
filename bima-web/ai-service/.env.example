# Shared secret between the web app and this service (must equal INTERNAL_API_SECRET in web/.env)
INTERNAL_API_SECRET=
AI_SERVICE_ALLOWED_ORIGINS="http://localhost:3000"
WEB_BASE_URL="http://127.0.0.1:3000"

# --- Local SAM3 provider ---
# Path to the SAM 3.1 weights (gated download, never commit them)
SAM3_CHECKPOINT=/path/to/sam3_1.pt
# ffmpeg with libx264 (the anaconda build lacks it; /usr/bin/ffmpeg has it)
FFMPEG_PATH=/usr/bin/ffmpeg
# Unload SAM3 from the GPU after this many idle seconds (<0 = keep loaded)
SAM3_IDLE_UNLOAD_SECONDS=30
# Optional overrides of the video algorithm preset: SAM3_DETECT_INTERVAL, SAM3_PROPAGATION (hold|phase|flow), SAM3_FLOW_SCALE (leave unset to use the preset)

# Upload annotated results to the Supabase img / vids buckets
SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where `python main.py` listens (loopback only; never expose this service to the network)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# SAM3 tuning (required when the sam3 provider is used)
SAM3_IMGSZ=1036
SAM3_CONF=0.25
SAM3_FINDING_CONF=0.4
SAM3_IMAGE_MAX_SIDE=1280
SAM3_IMAGE_MIN_SIDE=640
SAM3_VIDEO_MAX_SIDE=960
SAM3_VIDEO_MAX_FRAMES=0
SAM3_POST_WORKERS=6
SAM3_OUTPUT_CRF=28

# VLM providers. HTTP-Referer is optional (header omitted when empty). ONPREMISE_ENDPOINT_URL is only used when a model config has no endpoint
OPENROUTER_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_AUTH_KEY_URL=https://openrouter.ai/api/v1/auth/key
OPENROUTER_HTTP_REFERER=
ONPREMISE_ENDPOINT_URL=
