# Shared secret between the web app and this service (must equal INTERNAL_API_SECRET in web/.env)
INTERNAL_API_SECRET=
AI_SERVICE_ALLOWED_ORIGINS="http://localhost:3000"
WEB_BASE_URL="http://127.0.0.1:3000"

# --- Local SAM3 provider ---
# Path to the SAM 3.1 weights (gated download, never commit them)
SAM3_CHECKPOINT=/path/to/sam3_1.pt
# ffmpeg with libx264 (the anaconda build lacks it; /usr/bin/ffmpeg has it)
FFMPEG_PATH=/usr/bin/ffmpeg
# Unload SAM3 from the GPU after this many idle seconds (<0 = keep loaded)
SAM3_IDLE_UNLOAD_SECONDS=30
# Optional tuning: SAM3_IMGSZ=1036, SAM3_CONF=0.25, SAM3_FINDING_CONF=0.4, SAM3_DETECT_INTERVAL, SAM3_PROPAGATION, SAM3_FLOW_SCALE

# Upload annotated results to the Supabase img / vids buckets
SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
