# Compose-level settings for docker-compose.yml in this directory.
# Copy to bima-web/.env. This file configures *Docker itself*, not the applications:
# the app configuration still lives in web/.env and ai-service/.env.

# Absolute path on this host to the SAM 3.1 checkpoint. It is mounted read-only into the
# ai-service container at /weights/sam3_1.pt. Compose refuses to start if this is unset.
SAM3_WEIGHTS_HOST_PATH=/path/to/publicspace_vlm/sam3_1.pt

# Host port the web container is published on (container-internal port stays 3000).
# Use a free port to run alongside a natively-running dev server; use 3000 when the container
# takes over. Tailscale Serve forwards to a fixed port, so keep it in sync:
#   tailscale serve --bg --https=8443 <WEB_HOST_PORT>
WEB_HOST_PORT=3100
